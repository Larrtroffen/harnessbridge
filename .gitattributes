# Normalize line endings for text files
* text=auto eol=lf

# Explicit text formats
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.jsonl         text eol=lf
*.py            text eol=lf
*.swift         text eol=lf
*.sh            text eol=lf
*.toml          text eol=lf
*.txt           text eol=lf
*.plist         text eol=lf

# Binary assets — never diff/eol-convert
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.icns          binary
*.zstd          binary
*.dmg           binary
*.zip           binary
*.pdf           binary
*.ttf           binary
*.otf           binary
*.ttc           binary
